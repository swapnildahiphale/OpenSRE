# =============================================================================
# CORE CREDENTIALS
# =============================================================================

# LLM API Key — direct Anthropic access for the Claude Agent SDK engine.
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
MEMORY_LLM_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here

# Laminar Tracing (optional)
LMNR_PROJECT_API_KEY=your-laminar-api-key-here

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# The agent uses the Claude Agent SDK with direct Anthropic by default.
# For multi-provider routing, run the optional LiteLLM proxy and set
# ANTHROPIC_BASE_URL to its endpoint (OpenRouter, Gemini, OpenAI, local models).

# =============================================================================
# DEMO INTEGRATIONS (Required for Demo with OTel Demo App)
# =============================================================================

# Coralogix (REQUIRED for demo)
CORALOGIX_API_KEY=your-coralogix-api-key
CORALOGIX_DOMAIN=https://opensre.app.coralogix.com/

# AWS (REQUIRED for demo - EKS cluster access)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# GitHub (vcs-github skill — code context, PR/Actions investigation)
# Personal Access Token (classic or fine-grained). Passed to gh CLI in sre-agent.
GITHUB_TOKEN=ghp_...
# GITHUB_REPOSITORY=your-org/your-repo  # Optional default repo for gh commands
# See sre-agent/.claude/skills/vcs-github/.env.example for enterprise (GH_HOST) vars.

# Option 2: GitHub App (higher rate limits — not used by vcs-github skill v1)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_B64=LS0tLS...  # base64 encoded private key
# GITHUB_INSTALLATION_ID=789012
# GITHUB_WEBHOOK_SECRET=...

# Kubernetes (auto-configured)
# Pre-configured to use opensre-demo cluster in us-west-2
# No configuration needed - kubeconfig baked into Docker image

# =============================================================================
# OPTIONAL INTEGRATIONS (Additional monitoring platforms)
# =============================================================================

# =============================================================================
# Monitoring & Observability (optional)
# =============================================================================

# Coralogix
CORALOGIX_API_KEY=your-coralogix-api-key
CORALOGIX_DOMAIN=https://yourteam.app.cx498.coralogix.com/

# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
# DATADOG_SITE=datadoghq.com  # Optional, default: datadoghq.com

# Prometheus & Alertmanager
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key

# Sentry
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORGANIZATION=your-org-slug
# SENTRY_PROJECT=your-project-slug  # Optional

# =============================================================================
# Logging Backends (optional)
# =============================================================================

# Elasticsearch
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=logs-*  # Optional

# Loki
# LOKI_URL=http://loki:3100

# Splunk
# SPLUNK_HOST=splunk.example.com
# SPLUNK_TOKEN=your-splunk-token
# SPLUNK_PORT=8089  # Optional, default: 8089

# =============================================================================
# Collaboration & Communication (optional)
# =============================================================================

# GitHub (vcs-github skill)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_REPOSITORY=owner/repo  # Optional default repository

# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
# SLACK_DEFAULT_CHANNEL=C01234ABCDE  # Optional

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key

# =============================================================================
# Advanced Features (optional)
# =============================================================================

# Investigation history database
HISTORY_DB_PATH=~/.opensre/history.db

# Remediation audit log
REMEDIATION_LOG_PATH=~/.opensre/logs/remediation.log

# Investigation timeout (seconds)
# Default: 600 (10 minutes)
# Increase for complex investigations with many subagents or long-running queries
# AGENT_TIMEOUT_SECONDS=600
