# Copy these into repo root .env (docker-compose env_file → sre-agent).
# GitHub.com — config-free headless auth via gh CLI
GITHUB_TOKEN=replace-with-github-personal-access-token

# Optional defaults (omit to pass -R owner/repo on each command)
# GITHUB_REPOSITORY=your-org/your-repo
# GH_REPO=your-org/your-repo

# GitHub Enterprise Server (uncomment and adjust instead of github.com defaults):
# GH_HOST=github.example.com
# GITHUB_ENTERPRISE_TOKEN=replace-with-enterprise-token
