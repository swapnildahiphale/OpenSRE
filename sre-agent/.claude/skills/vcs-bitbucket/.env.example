# Copy these into repo root .env (docker-compose env_file → sre-agent).
# Bitbucket Cloud (primary OpenSRE pattern — config-free headless auth)
BKT_HOST=https://bitbucket.org
BKT_TOKEN=replace-with-atlassian-api-token-scoped-to-bitbucket
BKT_USERNAME=you@example.com
BKT_WORKSPACE=your-workspace

# Optional defaults (omit to pass --workspace / --project / --repo per command)
# BKT_REPO=your-repo

# Data Center example (uncomment and adjust instead of Cloud vars above):
# BKT_HOST=https://bitbucket.example.com
# BKT_TOKEN=replace-with-personal-access-token
# BKT_USERNAME=your.dc.username
# BKT_PROJECT=YOUR_PROJECT_KEY
