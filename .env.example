# ============================================
# OpenSRE — Local Development Environment
# ============================================
# Copy to .env and fill in your values.
# Then run: make dev
#
# Required: LLM_PROVIDER + LLM_MODEL + the matching API key
# Everything else is optional depending on what you want to test.
#
# Local datastore/API ports in docker-compose.yml are bound to 127.0.0.1 only
# (Postgres :5433, Neo4j :7475/:7688, config-service :8081, sre-agent :8001,
#  web-ui :3002, Teams :3978). Documented local-dev credential defaults stay so
# `make dev` remains a single command.

# ============================================
# LLM Configuration (required)
# ============================================
# Direct Anthropic API (preferred — no proxy required)
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
# Memory helper uses a faster/cheaper model for short extractions
MEMORY_LLM_MODEL=claude-haiku-4-5-20251001

# Legacy multi-provider (optional — leave blank to use Anthropic above)
# Provider: nvidia, openrouter
#LLM_PROVIDER=nvidia
# Model name (must match your provider's model format)
# NVIDIA examples:  nvidia_nim/nvidia/llama-3.1-nemotron-ultra-253b-v1
# OpenRouter examples: openrouter/anthropic/claude-sonnet-4, openrouter/google/gemini-2.5-pro
#LLM_MODEL=nvidia_nim/nvidia/llama-3.1-nemotron-ultra-253b-v1

# ============================================
# Configuration Mode
# ============================================
# "local" enables YAML-based config from config_service/config/local.yaml.
# Hot-reload is on — edit the YAML file and changes apply without restart.
CONFIG_MODE=local

# ============================================
# Provider API Keys (set the one matching your LLM_PROVIDER)
# ============================================
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Additional provider keys (for alternate providers)

# OpenAI (gpt-4o, gpt-4o-mini, o1, o3, o4-mini, ...)
#OPENAI_API_KEY=sk-your-openai-key

# Google Gemini (gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash, ...)
#GEMINI_API_KEY=your-gemini-key

# DeepSeek (deepseek-chat, deepseek-reasoner, ...)
#DEEPSEEK_API_KEY=your-deepseek-key

# Mistral AI (mistral-large-latest, mistral-small-latest, codestral-latest, ...)
#MISTRAL_API_KEY=your-mistral-key

# xAI / Grok (grok-3, grok-3-beta, grok-2-latest, ...)
#XAI_API_KEY=your-xai-key

# Groq — fast hosted inference (llama-3.3-70b-versatile, llama-4-scout, ...)
#GROQ_API_KEY=gsk_your-groq-key

# Cohere (command-a-03-2025, command-r-plus, ...)
#COHERE_API_KEY=your-cohere-key

# Ollama — local models, no API key needed (configure base_url in local.yaml)

# AWS Bedrock — Claude, Llama, Mistral via AWS
#AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token

# Azure AI Foundry — serverless model endpoints
#AZURE_AI_API_KEY=your-azure-ai-key
#AZURE_AI_API_BASE=https://your-endpoint.services.ai.azure.com

# ============================================
# Slack (required for Slack integration)
# ============================================
# See docs/SLACK_SETUP.md for how to create a Slack app and get these tokens.
# Without these, the slack-bot exits gracefully — other services still run.

# Bot Token from OAuth & Permissions
#SLACK_BOT_TOKEN=xoxb-your-bot-token

# App Token for Socket Mode (from Basic Information -> App-Level Tokens)
#SLACK_APP_TOKEN=xapp-your-app-token  # Socket Mode app-level token

# ============================================
# Microsoft Teams (optional — for Teams bot integration)
# ============================================
# Without these, teams-bot exits gracefully — other services still run.
# Start with: make dev-teams  (docker compose --profile teams up)

#TEAMS_APP_ID=
#TEAMS_APP_PASSWORD=
#TEAMS_TENANT_ID=

# ============================================
# Config Service (defaults work out of the box)
# ============================================
# Only override these if you need custom values.
#TOKEN_PEPPER=localdev-pepper-must-be-32-chars-minimum!!
#ADMIN_TOKEN=local-admin-token
#IMPERSONATION_JWT_SECRET=local-dev-impersonation-secret-32chars!!

# ============================================
# Sandbox Security (required)
# ============================================
# JWT secret for sandbox credential-proxy authentication.
# Must be the same value in sre-agent and credential-resolver.
JWT_SECRET=local-dev-jwt-secret-change-in-prod

# ============================================
# Observability Integrations (optional)
# ============================================
# These match the integrations section in local.yaml.
# Add the key here, then uncomment the integration block in local.yaml.

#CORALOGIX_API_KEY=your-coralogix-key
#CORALOGIX_DOMAIN=https://yourteam.app.cx498.coralogix.com

#DATADOG_API_KEY=
#DATADOG_APP_KEY=

#GRAFANA_URL=
#GRAFANA_API_KEY=

#PROMETHEUS_URL=

#GITHUB_TOKEN=ghp_your-github-token

# -----------------------------------------------
# Jira (optional — for project-jira skill)
# -----------------------------------------------
# Two modes are supported. Pick one and fill in the matching vars.
#
# Cloud (atlassian.net):
#   JIRA_URL=https://your.atlassian.net
#   JIRA_EMAIL=you@example.com
#   JIRA_API_TOKEN=<cloud API token>
#   Leave JIRA_AUTH_SCHEME / JIRA_API_VERSION unset → defaults to Basic auth + /rest/api/3 (ADF).
#
# Data Center (self-hosted, PAT auth):
#   JIRA_URL=https://jira.yourcorp.com
#   JIRA_API_TOKEN=<personal access token>
#   JIRA_AUTH_SCHEME=bearer
#   JIRA_API_VERSION=2
#   Omit JIRA_EMAIL. Bodies are sent as Jira Wiki Markup (supports *bold*, _italic_, ||tables||, {code}, ...).
#
# Cloud template (uncomment to use):
#JIRA_URL=https://your.atlassian.net
#JIRA_EMAIL=you@example.com
#JIRA_API_TOKEN=
#
# Data Center template (uncomment to use):
#JIRA_URL=https://jira.yourcorp.com
#JIRA_API_TOKEN=
#JIRA_AUTH_SCHEME=bearer
#JIRA_API_VERSION=2

# -----------------------------------------------
# Jenkins (optional — for platform-jenkins skill)
# -----------------------------------------------
# Set in repo root .env (passed to sre-agent via docker-compose env_file).
# See sre-agent/.claude/skills/platform-jenkins/.env.example
#JENKINS_LEGACY_BASE_URL=https://jenkins.example.com
#JENKINS_LEGACY_USERNAME=your.username
#JENKINS_LEGACY_API_TOKEN=
#JENKINS_AWS_BASE_URL=https://jenkins-aws.example.com
#JENKINS_AWS_USERNAME=your.username
#JENKINS_AWS_API_TOKEN=
#JENKINS_HTTP_TIMEOUT=20

# -----------------------------------------------
# Argo CD (optional — for platform-argocd skill)
# -----------------------------------------------
# Set in repo root .env (passed to sre-agent via docker-compose env_file).
# See sre-agent/.claude/skills/platform-argocd/.env.example
#ARGOCD_SERVER=argocd.example.com
#ARGOCD_USERNAME=admin
#ARGOCD_PASSWORD=
#ARGOCD_GRPC_WEB=true
#ARGOCD_HTTP_TIMEOUT=30

# -----------------------------------------------
# Bitbucket (optional — for vcs-bitbucket skill)
# -----------------------------------------------
# Primary auth: BKT_* env vars (config-free; no bkt auth login required).
# See sre-agent/.claude/skills/vcs-bitbucket/.env.example
#
# Bitbucket Cloud:
#BKT_HOST=https://bitbucket.org
#BKT_TOKEN=
#BKT_USERNAME=you@example.com
#BKT_WORKSPACE=your-workspace
#
# Data Center:
#BKT_HOST=https://bitbucket.example.com
#BKT_TOKEN=
#BKT_USERNAME=your.dc.username
#BKT_PROJECT=YOUR_PROJECT_KEY

# -----------------------------------------------
# Kronos (optional — for platform-kronos skill)
# -----------------------------------------------
# See sre-agent/.claude/skills/platform-kronos/.env.example
#KRONOS_BASE_URL=https://kronos.example.com
#KRONOS_SESSION=
#KRONOS_HTTP_TIMEOUT=30

# ============================================
# AWS (optional — for CloudWatch, EKS, EC2 queries)
# ============================================
# Local dev uses the SSO mount approach, NOT static keys:
#   - docker-compose mounts ~/.aws read-WRITE (so the aws CLI can refresh expired
#     SSO tokens) and ~/.kube read-only into the sre-agent container (VirtioFS
#     remaps ownership so the non-root agent can read them).
#   - boto3 skill scripts use AWS_PROFILE below.
#   - kubectl/EKS auth uses the per-context AWS_PROFILE baked into ~/.kube/config
#     (the `aws` CLI is installed in the sre-agent image for `aws eks get-token`).
# When the SSO token expires, re-run `aws sso login` on the host.
#
# Default profile/region for boto3 skill scripts (override to match a profile
# name from your host ~/.aws/config — the account you are investigating).
#AWS_PROFILE=default
#AWS_DEFAULT_REGION=us-west-2
#AWS_REGION=us-west-2
#
# Static long-lived keys are also supported if you prefer not to use SSO:
#AWS_ACCESS_KEY_ID=your-access-key
#AWS_SECRET_ACCESS_KEY=your-secret-key
#AWS_REGION=us-west-2

# ============================================
# Neo4j — topology KG + episodic memory (single source of truth)
# ============================================
# Used by docker-compose (NEO4J_AUTH + sre-agent) and host-side tools/pytest.
# Browser UI: http://localhost:7475  |  Bolt from host: bolt://localhost:7688
# Inside Docker (sre-agent): compose sets NEO4J_URI=bolt://neo4j:7687 automatically.
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=localdev
NEO4J_DATABASE=neo4j

# ============================================
# Agent execution limits
# ============================================
# max_turns (SDK tool-call budget) is NOT an .env variable. Set it per agent in
# Admin → Configuration → Agents (config-service merge; planner default is 50).
# Wall-clock timeout: AGENT_TIMEOUT_SECONDS in docker-compose.yml (default 600).

# ============================================
# Tracing & Debug (optional)
# ============================================
#LMNR_PROJECT_API_KEY=lm_your-key  # Laminar tracing for agent behavior
#LOG_LEVEL=INFO
